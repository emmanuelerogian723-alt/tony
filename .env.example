# ── Tony core ──────────────────────────────────────────────────────────────
# Public URL of this instance (used for OAuth redirects)
TONY_BASE_URL=http://localhost:8000
# Encrypts connected-account credentials at rest. Generate: openssl rand -hex 32
TONY_SECRET_KEY=
# Required to create workspaces when the demo is closed
TONY_ADMIN_TOKEN=
# Leave 1 for the public demo workspace (read-only friendly), 0 for locked-down
TONY_DEMO_OPEN=1
# Require explicit approval before write/destructive actions
TONY_REQUIRE_APPROVAL=1
# Postgres in production, SQLite by default
# DATABASE_URL=postgresql://user:pass@host:5432/tony

# ── OAuth client credentials (only for the apps you enable) ────────────────
# GitHub  → https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google (Gmail, Calendar, Drive, Sheets, YouTube)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Slack → https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Notion / Discord / X / TikTok / Microsoft / Zoom / LinkedIn / Reddit
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

